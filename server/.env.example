# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MONGODB_URI is standard; MONGO_URI also works)
MONGODB_URI=mongodb://localhost:27017/yumbite

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Bootstrap admin account (backend only — seeds the first admin user)
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Resend email service (backend only — never expose in frontend code)
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# Public site URL used for password-reset context
FRONTEND_URL=http://localhost:5173

# Google OAuth (customer sign-in — client ID only, never put a secret in code)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized origin: http://localhost:5173 (add production domain on deploy)
# NOTE: this project uses Google Identity Services (ID-token flow), which
# needs no client secret. Never add a Google secret to the frontend.
GOOGLE_CLIENT_ID=

# SSLCommerz sandbox (online payment — backend only, never expose in frontend)
# Get test credentials: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Public backend URL (used to build gateway callback URLs)
BACKEND_URL=http://localhost:5000